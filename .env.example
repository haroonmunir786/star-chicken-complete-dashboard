# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Port Render will set this automatically, safe to leave as-is
PORT=4000

# Comma-separated list of origins allowed to call this API
# (your future hosted frontend URL, plus http://localhost for local testing)
CORS_ORIGIN=http://localhost:5500,https://your-frontend-domain.com

# Used only by scripts/seedAdmin.js to create the first Super Admin
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PIN=1234
